# Git 行尾与二进制类型声明
# 作用：防止 Git 把 .uasset / .png 当文本做换行符转换（会直接损坏资产）

# 文本文件：入库统一 LF，检出时按系统
* text=auto

# Windows 批处理必须以 CRLF 保存，否则 cmd 解析出错
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 游戏资产：二进制，禁止任何转换，禁止做 diff
*.uasset binary
*.umap  binary
*.ubulk binary
*.uexp  binary
*.upk   binary
*.pak   binary
*.utoc  binary
*.ucas  binary

# 图片 / 音频 / 模型
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.fbx  binary
*.pdb  binary
*.dll  binary
*.exe  binary

# 文档与文本源
*.md text
*.svg text
*.obj text
*.json text
*.ini text
*.cs text
*.cpp text
*.h text
